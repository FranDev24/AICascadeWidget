# AICascadeWidget — Configuración de entorno
# Copia este archivo como `.env` y completa tus valores.
# Obtén URL y keys en: https://supabase.com/dashboard > tu proyecto > Settings > API

SUPABASE_URL=https://tu-proyecto.supabase.co
# Acepta cualquiera de estas (el backend prueba en orden):
SUPABASE_KEY=tu-service-role-o-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Puerto del backend FastAPI (por defecto 8000)
PORT=8000
HOST=127.0.0.1
